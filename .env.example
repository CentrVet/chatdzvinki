# Phonet API
PHONET_DOMAIN=centrvet.phonet.com.ua
PHONET_API_KEY=XVpeALRK0hkDK0w9bIxHlzqM1HQxVYdJ

# Anthropic (Claude) - получить на https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Telegram - токен от @BotFather, chat_id от @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Whisper
WHISPER_MODEL=small
# small - быстрее, медленнее работает на CPU, достаточно для оценки
# medium - точнее, но в 3 раза медленнее

# Фильтры
MIN_DURATION_SECONDS=20
# Опрашивать звонки за последние N минут
POLL_WINDOW_MINUTES=15
# Как часто опрашивать (используется только в режиме main.py loop)
POLL_INTERVAL_MINUTES=10

# Только входящие (4) / все направления - оставьте 4 для кол-центра
DIRECTIONS=4
